# Server configuration. Copy to .env and fill in real values.
# DO NOT commit a real .env file.

# --- HTTP ---
PORT=8080

# --- Auth ---
# REQUIRED in production. The server refuses to start with the dev secret.
JWT_SECRET=replace-me-with-a-32-byte-random-string

# --- Database ---
POSTGRES_URL=postgres://bingo:bingo@localhost:5432/bingozen

# --- Cache / hot state ---
REDIS_URL=redis://localhost:6379

# --- Game tuning ---
ROOM_TTL_SECONDS=3600
MATCH_GRACE_PERIOD_MS=60000

# --- Public web / PWA ---
PWA_DOMAIN=localhost:8080

# --- Feature flags (1 = on, 0 = off) ---
FEATURE_ADS=0
FEATURE_LEADERBOARD=1
FEATURE_FRIENDS=1
FEATURE_NOTIFICATIONS=1
FEATURE_RATING=1
FEATURE_ANALYTICS=1